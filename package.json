{
  "name": "genescan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "apps/mobile/index.js",
  "scripts": {
    "dev": "node --env-file=.env scripts/ensure-gateway.js && vite apps/web",
    "build": "vite build apps/web",
    "mobile": "node --env-file=.env scripts/ensure-gateway.js && expo start",
    "test": "node --test apps/gateway/*.test.js packages/shared/*.test.js packages/supabase/*.test.js",
    "selenium": "mocha selenium-tests/tests/*.js --timeout 30000",
    "appium": "mocha appium-tests/tests/*.js --timeout 60000",
    "lint": "eslint apps packages scripts selenium-tests appium-tests security performance",
    "format": "prettier --write apps packages scripts",
    "gateway": "node --env-file=.env apps/gateway/server.js",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.95.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-sharing": "~58.0.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-router-dom": "^7.18.6",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "chai": "^6.0.0",
    "eslint": "^9.0.0",
    "mocha": "^11.0.0",
    "prettier": "^3.0.0",
    "selenium-webdriver": "^4.30.0",
    "vite": "^7.0.0",
    "webdriverio": "10.2.0"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "^11.0.9"
    },
    "mocha": {
      "diff": "^8.0.3",
      "glob": "^14.0.6",
      "minimatch": "^11.0.9",
      "serialize-javascript": "^7.1.4"
    },
    "readdir-glob": {
      "minimatch": "^11.0.9"
    }
  }
}
